}

// ======================================================
// SD CARD FUNCTIONS
// ======================================================

void writeToSD(String data)
{
  File file = SD.open("DATA.CSV", FILE_WRITE);

  if (file)
  {
    file.println(data);
    file.close();

    Serial.println("SD: Data Saved");
  }
  else
  {
    Serial.println("SD: Write Failed");
  }
}

void readCSV()
{
  File file = SD.open("DATA.CSV");

  if (file)
  {
    Serial.println();
    Serial.println("===== DATA.CSV CONTENT =====");

    while (file.available())
    {
      Serial.write(file.read());
    }

    file.close();

    Serial.println();
    Serial.println("===== END OF FILE =====");
  }
  else
  {
    Serial.println("Unable to open DATA.CSV");
  }
}

void showStatus()
{
  Serial.println();
  Serial.println("===== SD CARD STATUS =====");

  if (SD.exists("DATA.CSV"))
  {
    File file = SD.open("DATA.CSV");

    if (file)
    {
      Serial.print("File Exists : YES\n");

      Serial.print("File Size : ");
      Serial.print(file.size());
      Serial.println(" bytes");

      file.close();
    }
  }
  else
  {
    Serial.println("File Exists : NO");
  }

  Serial.println("==========================");
}

void clearCSV()
{
  if (SD.exists("DATA.CSV"))
  {
    SD.remove("DATA.CSV");
    Serial.println("Old DATA.CSV Deleted");
  }

  File file = SD.open("DATA.CSV", FILE_WRITE);

  if (file)
  {
    file.println(
        "Time,Temp,TempStatus,Humidity,HumidityStatus,Light,"
        "Plant1,Plant1Status,"
        "Plant2,Plant2Status,"
        "Plant3,Plant3Status,"
        "Plant4,Plant4Status,"
        "Average,AverageStatus");

    file.close();

    Serial.println("New DATA.CSV Created");
  }
  else
  {
    Serial.println("Failed To Create DATA.CSV");
  }
}

// ======================================================
// SOIL SENSOR FILTERING
// ======================================================

int readSoilSensor(byte pin)
{
  long sum = 0;

  for (int i = 0; i < 10; i++)
  {
    sum += analogRead(pin);
    delay(5);
  }

  return sum / 10;
}

// ======================================================
// SENSOR HEALTH CHECK
// ======================================================

String getSensorHealth(int rawValue)
{
  if (rawValue <= 5)
    return "DISCONNECTED";

  if (rawValue >= 1018)
    return "DISCONNECTED";

  return "OK";
}
int getSystemHealth(int raw1, int raw2, int raw3, int raw4)
{
  int health = 100;

  if (getSensorHealth(raw1) != "OK")
    health -= 25;

  if (getSensorHealth(raw2) != "OK")
    health -= 25;

  if (getSensorHealth(raw3) != "OK")
    health -= 25;

  if (getSensorHealth(raw4) != "OK")
    health -= 25;

  return health;
}
