      "&field4=" + String(p1) +
      "&field5=" + String(p2) +
      "&field6=" + String(p3) +
      "&field7=" + String(p4) +
      "&field8=" + String(systemHealth);

    client.print(
      String("GET ") + url +
      " HTTP/1.1\r\n" +
      "Host: api.thingspeak.com\r\n" +
      "Connection: close\r\n\r\n"
    );

    Serial.println("Uploading To ThingSpeak...");

   unsigned long timeout = millis();

while (client.available() == 0)
{
  if (millis() - timeout > 5000)
  {
    Serial.println("ThingSpeak Timeout");
    client.stop();
    return;
  }
}

Serial.println("ThingSpeak Upload Success");

while (client.available())
{
  client.read();
}

client.stop();
  }
  else
  {
    Serial.println("ThingSpeak Connection Failed");
  }
}
// ======================================================
// SETUP
// ======================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  dht.begin();
  pinMode(LDR_PIN, INPUT);

  // SD CARD INIT
  if (SD.begin(chipSelect))
  {
    Serial.println("SD Card Ready");

    if (!SD.exists("DATA.CSV"))
    {
      File file = SD.open("DATA.CSV", FILE_WRITE);

      if (file)
      {
        file.println(
            "Time,Temp,TempStatus,Humidity,HumidityStatus,Light,"
            "Plant1,Plant1Status,"
            "Plant2,Plant2Status,"
            "Plant3,Plant3Status,"
            "Plant4,Plant4Status,"
            "Average,AverageStatus");

        file.close();
      }
    }
  }
  else
  {
    Serial.println("SD Card Failed");
  }

  // WIFI
  connectWiFi();

  // NTP
  timeClient.begin();

  while (!timeClient.update())
  {
    timeClient.forceUpdate();
  }

  Serial.println("NTP Time Synced");
}

// ======================================================
// LOOP
// ======================================================

void loop()
{
  // SERIAL COMMANDS

  if (Serial.available())
  {
    String command = Serial.readStringUntil('\n');
    command.trim();

    if (command == "READ")
    {
      readCSV();
      return;
    }

    if (command == "STATUS")
    {
      showStatus();
      return;
    }

    if (command == "CLEAR")
    {
      clearCSV();
      return;
    }
