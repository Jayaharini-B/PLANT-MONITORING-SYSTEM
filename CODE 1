int wetValue = 300;

// ======================================================
// FUNCTIONS
// ======================================================

int convertToPercent(int value)
{
  return constrain(map(value, dryValue, wetValue, 0, 100), 0, 100);
}

String getMoistureStatus(int moisture)
{
  if (moisture <= 15)
    return "Dry";
  else if (moisture <= 30)
    return "Low";
  else if (moisture <= 60)
    return "Optimal";
  else if (moisture <= 80)
    return "Wet";
  else
    return "Saturated";
}

String getTempStatus(float temp)
{
  if (temp < 20)
    return "Cold";
  else if (temp <= 30)
    return "Normal";
  else
    return "Hot";
}

String getHumidityStatus(float hum)
{
  if (hum < 30)
    return "Dry";
  else if (hum <= 60)
    return "Comfort";
  else
    return "Humid";
}

String getLightStatus(int lightState)
{
  if (lightState == LOW)
    return "Bright";
  else
    return "Dark";
}

// ======================================================
// REAL DATE & TIME FROM NTP
// ======================================================

String getTimestamp()
{
  timeClient.update();

  unsigned long epochTime = timeClient.getEpochTime();

  time_t rawTime = epochTime;

  struct tm *timeInfo = localtime(&rawTime);

  char buffer[25];

  sprintf(buffer,
          "%04d-%02d-%02d %02d:%02d:%02d",
          timeInfo->tm_year + 1900,
          timeInfo->tm_mon + 1,
          timeInfo->tm_mday,
          timeInfo->tm_hour,
          timeInfo->tm_min,
          timeInfo->tm_sec);

  return String(buffer);
}

